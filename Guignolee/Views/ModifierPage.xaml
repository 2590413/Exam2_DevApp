<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Guignolee.Views.ModifierPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Guignolee.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Guignolee.ViewModels"
    mc:Ignorable="d">

    <StackPanel Padding="16" Spacing="12">
        <!--  En-tête : Logo et titre  -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="Pink" BorderThickness="1">
                <Image
        Grid.Column="0"
        Width="72"
        Height="72"
        AutomationProperties.Name="Illustration : une boîte de dons avec un ruban"
        Source="ms-appx:///Assets/Images/geralt-christmas-9185561.jpg" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
        AutomationProperties.HeadingLevel="Level1"
        FontSize="28"
        FontWeight="SemiBold"
        Text="Registre des dons"
        TextWrapping="Wrap" />
                <TextBlock Text="Guignolée du cégep" />
            </StackPanel>
        </Grid>

        <Grid
     Grid.Row="4"
     Padding="16"
     Background="White"
     BorderBrush="#A4262C"
     BorderThickness="1"
     CornerRadius="8">
            <StackPanel Spacing="12">
                <TextBlock
             AutomationProperties.HeadingLevel="Level2"
             FontSize="18"
             FontWeight="SemiBold"
             />

                <StackPanel>
                        <TextBox
                     Header="Donateur"
                     PlaceholderText="Prénom Nom"
                     Text="{x:Bind ViewModel.DonEdit.Donateur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     />

                        <ItemsView 
                     AutomationProperties.Name="Erreurs du donateur"
                     ItemsSource="{x:Bind ViewModel.DonEdit.GetErrors('Donateur'), Mode=OneWay}" 
                     Foreground="Coral"
                     >
                            <ItemsView.Resources>
                                <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent"/>
                            </ItemsView.Resources>

                        </ItemsView>
                    </StackPanel>

                    <StackPanel>
                        <TextBox
                     Header="Contenu du don"
                     PlaceholderText="Ex. : Conserves de soupe"
                     Text="{x:Bind ViewModel.DonEdit.Contenu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ItemsView
                     AutomationProperties.Name="Erreurs du contenu"
                      ItemsSource="{x:Bind ViewModel.DonEdit.GetErrors('Contenu'), Mode=OneWay}" 
                      Foreground="Coral">
                            <ItemsView.Resources>
                                <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent"/>
                            </ItemsView.Resources>

                        </ItemsView>
                    </StackPanel>

                    <StackPanel>
                        <TextBox
                     Header="Quantité"
                     MaxLength="3"
                     PlaceholderText="Ex. : 24"
                     Text="{x:Bind ViewModel.DonEdit.Quantite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ItemsView 
                     AutomationProperties.Name="Erreurs de la quantité"
                      ItemsSource="{x:Bind ViewModel.DonEdit.GetErrors('Quantite'), Mode=OneWay}" 
                      Foreground="Coral">
                            <ItemsView.Resources>
                                <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent"/>
                            </ItemsView.Resources>

                        </ItemsView>
                    </StackPanel>

                    <CheckBox
                 Margin="0,28,0,0"
                 VerticalAlignment="Top"
                 Content="Périssable"
                 IsChecked="{x:Bind ViewModel.DonEdit.EstPerissable, Mode=TwoWay}"
                 />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                
                    <Button
                     Margin="0,28,0,0"
                     Grid.Column="0"
                     VerticalAlignment="Top"
                     Background="#A4262C"
                     Click="btnEnregistrer_Click"
                     IsEnabled="{x:Bind ViewModel.DonEdit.EstValide, Mode=OneWay}"
                     Style="{StaticResource AccentButtonStyle}"
                     Content="Enregistrer"
                     Foreground="White" />
                    <Button
                     Margin="0,28,0,0"
                     Grid.Column="1"
                     VerticalAlignment="Top"
                     Click="btnAnnuler_Click"
                     Content="Annuler"
                     />

                </Grid>
            </StackPanel>
        </Grid>
    </StackPanel>
</Page>
